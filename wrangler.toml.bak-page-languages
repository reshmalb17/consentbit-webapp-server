# Fixed-OTP review/test account. When both are set, request-code issues this exact
# code for this one email and skips sending an email (see authRequestCode.js).
# Leave blank to disable. The matching User row must exist in the DB.
TEST_LOGIN_EMAIL = "test@consentbit.com"
TEST_LOGIN_CODE = "424242"

# Public Worker URL for stored embed `<script src>` (no trailing slash). Prefer setting **CDN_BASE_URL**
# in Cloudflare → Workers → your worker → Settings → Variables (so production isn’t tied to this file).
# If unset here and not in the dashboard, the Worker uses `request.url.origin` (OK when the API is called on the worker hostname).
CDN_BASE_URL = ""
# Public origin of your Next.js app (no trailing slash). If set, embed tries https://<WEBAPP>/asset/logo.webp first; on failure it loads /embed/floating-logo.svg from this Worker. If empty, the Worker SVG is used directly.
# Also the origin used to build emailed links — email verification, ownership transfer,
# and the billing link in Stripe emails. Left EMPTY on production (see [env.production.vars]),
# where those fall back to accounts.consentbit.com. Pointed here at the Test webapp so a
# tester clicking a confirmation link lands on the build they are testing, not on live.
WEBAPP_PUBLIC_URL = "https://consentbitfrontend.pages.dev"
# ── Webflow App OAuth (Data Client) — default env (consent-webapp-manager) ───
#   Secrets (NOT in this file): `wrangler secret put webflow_TEST_CLIENT_ID`
#                               `wrangler secret put WEBFLOW_CLIENT_TEST_SECRET`
#   The REDIRECT_URI below must EXACTLY match a Redirect URI registered in the
#   Webflow App settings. Only needed for NEW installs (authorize/callback);
#   already-authorized users work from the stored KV/D1 token without secrets.
WEBFLOW_OAUTH_SCOPES = "sites:read sites:write authorized_user:read custom_code:read custom_code:write"
WEBFLOW_OAUTH_REDIRECT_URI = "https://consent-webapp-manager.web-8fb.workers.dev/api/webflow/oauth/callback"
WEBFLOW_APP_REDIRECT = ""
# --- Tier plans (Basic / Essential / Growth) — one Stripe *subscription* per checkout, one recurring price per line item ---
# In Stripe Dashboard: create **3 products** (one per tier). Each product has **2 recurring prices** (month + year).
# Map those six price_ ids here. Checkout uses exactly one price → one subscription for the chosen plan + billing interval.
# Tier Basic/Essential/Growth: must be **Recurring** Stripe prices (subscription), not one-time — or Checkout returns "recurring price" errors.
# If only Basic fails: open the Basic product in Stripe → each price must say "Recurring" / subscription. One-time prices will not work.
