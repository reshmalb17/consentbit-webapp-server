name = "consent-webapp-manager"
main = "src/index.js"
compatibility_date = "2026-02-02"
compatibility_flags = ["nodejs_compat"]

[assets]
directory = "./public"

[[d1_databases]]
binding = "CONSENT_WEBAPP"
database_name = "consent-webapp-eu"
database_id = "1185db31-80ad-4021-b269-a439bd52e84d"

[[d1_databases]]
binding = "LEGACY_DB"
database_name = "consentbit-licenses"
database_id = "3a0cf7e2-34a9-4d06-a5b7-c1238d13290e"

[[d1_databases]]
binding = "BANNER_CONFIG_DB"
database_name = "banner-config-db"
database_id = "8b467c8c-2ff8-43b5-9338-a4e9191e6014"

# Cookie-scanner DB (same D1 the cookie-scanner worker writes to). Bound here so the
# auth worker can read a handed-off scan report directly and render its PDF locally.
[[d1_databases]]
binding = "COOKIE_SCANNER_DB"
database_name = "cookie-scanner-db"
database_id = "b66e816a-d6df-463f-97aa-45ee475f6bbc"

# Expired consent records are MOVED here by the retention sweep (services/consentRetention.js)
# instead of being deleted. Schema: scripts/retention-db-schema.sql. Created 2026-10-15.
[[d1_databases]]
binding = "RETENTION_DB"
database_name = "consentbit-retention-data"
database_id = "3a0dd7c5-caa8-4355-a134-4e5c1e9e35e4"

[[kv_namespaces]]
binding = "WEBFLOW_AUTHENTICATION"
id = "aa64050ef7804e7783fe9680daae80c5"

[[r2_buckets]]
binding = "R2"
bucket_name = "cookies-data"

[[kv_namespaces]]
binding = "AUTH_STORE_FRAMER"
id = "6bf69f88af4e4f7ebe19f811e8b232b9"

[[kv_namespaces]]
binding = "BANNER_KV_FRAMER"
id = "d63b31eee44245b2a039b8f9566a6f44"

[[kv_namespaces]]
binding = "CONSENT_STORE_FRAMER"
id = "0ad4a627265c43279493720bf7532f77"

[[kv_namespaces]]
binding = "ACTIVE_SITES_CONSENTBIT"
id = "66c7aa5c7fcb4c2a8dfec5463e86a293"

[[kv_namespaces]]
binding = "ACTIVE_SITES_CONSENTBIT_FRAMER"
id = "f89c8bbb2dd843b8aebf30a745723a2c"

[[kv_namespaces]]
binding = "UN_ASSIGNED_LICENSE_KEYS"
id = "75ceeaf610d54418aa82480cad36e125"

[[kv_namespaces]]
binding = "CHECKOUT_TOKENS"
id = "353f494f977440feb2120b3464aa917a"

[vars]
# Structured [CB-FLOW] logs for the subscription renewal / cancellation workflow
# (src/utils/flowLog.js). TEST WORKER ONLY — deliberately NOT in [env.production.vars].
# Watch with: npx wrangler tail --search "CB-FLOW"
CB_FLOW_LOG = "1"
# Minimum-legal-requirements banner fixes (docs/minimum-legal-requirements.md): law
# recorded on consent rows, "Do Not Sell or Share" link title, 12-month CCPA opt-out,
# visitor consent ID. TEST WORKER ONLY — read in handlers/cdnM.js + consentLogs.js;
# "0" in [env.production.vars].
LAW_FIXES = "1"
# Where banners served by THIS worker post consents (cdnM.js apiBase). Unset, it falls
# back to https://manager.consentbit.com — the PRODUCTION worker — so test sites' consents
# were saved by prod code and law work (lawNames.js) never reached them. TEST WORKER ONLY;
# production keeps the fallback (not set in [env.production.vars]).
API_BASE_URL = "https://consent-webapp-manager.web-8fb.workers.dev"
# Hosted cookie transparency page — /cookie-list/<domain> + /api/transparency-page
# (handlers/transparencyPage.js). TEST WORKER ONLY — "0" in [env.production.vars].
# TRANSPARENCY_INDEX = "1" lets search engines index the pages (default noindex).
TRANSPARENCY_PAGE = "1"
TRANSPARENCY_INDEX = "0"
# Workflow switches. Unset in production until verified on Test.
#   CANCEL_INVOICE_VOID_MODE / CARD_PIN_FOLLOW_MODE: "off" | "dry-run" | "on"
CANCEL_INVOICE_VOID_MODE = "dry-run"
CARD_PIN_FOLLOW_MODE = "dry-run"
# Consent-record retention (services/consentRetention.js): rows older than 12 months
# (US/ccpa: 24 months) are MOVED to consentbit-retention-data (RETENTION_DB), then removed
# from Consent. ON by decision 2026-10-15. "dry-run" only COUNTS; "off" stops it.
# Test and production share the consent-webapp-eu D1, so ONE worker's setting covers every
# site. Moved to production 2026-10-17 — keep Test "off". Needs idx_consent_site_created.
CONSENT_RETENTION_MODE = "off"
# Owner emails before consent records are hidden (Free, 3 months) or removed (paid,
# 12 months) — services/retentionReminders.js. "off" | "dry-run" | "on". Shared D1 and
# claim table: ONE worker only, the same one as CONSENT_RETENTION_MODE.
RETENTION_REMINDERS = "off"
# Monthly combined invoice (services/combinedInvoice.js) — live Stripe only, so "off" in Test.
COMBINED_INVOICES = "off"
# "A new tracker showed up" emails after scheduled scans (services/newTrackerAlerts.js).
# "off" | "dry-run" (log only) | "on". Shared D1: enable on ONE worker only.
NEW_TRACKER_ALERTS = "on"
# Free fallback (services/freeFallback.js, 2026-11-05): when a site's paid plan ENDS
# (card failed through dunning, or a cancellation reached its period end) the site moves
# to the Free plan — only if no other site on the account already uses Free; otherwise it
# stays blocked (402) as before. "on" | "dry-run" (log only) | "off". Idempotent, so both
# workers may run it against the shared D1.
FREE_FALLBACK = "on"
# STRICT_SUBDOMAINS: "on" stops any-subdomain matching — shop.example.com no longer gets
# example.com's banner unless proven the same site (Webflow project / Framer fid /
# translated copy). Leave "off" until the [CDN] subdomain-legacy log lines are reviewed.
STRICT_SUBDOMAINS = "off"
# TRIAL_RESTRICT_RETURNING_SITES: "on" withholds the 14-day trial from a site that has any
# earlier subscription (item A). Anything else = returning sites get the trial again.
# Decided 2026-09-18: allow (services/db.js isSiteTrialIneligible).
TRIAL_RESTRICT_RETURNING_SITES = "off"
